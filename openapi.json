{
  "openapi": "3.1.0",
  "info": {
    "title": "C2C Merchant API",
    "version": "1.0.0",
    "description": "Create deposit and withdrawal orders, query order status and wallet balance. Every request is authenticated with a Bearer API key and signed with HMAC-SHA256 (X-C2C-Timestamp / X-C2C-Signature); order creation always enforces the signature and accepts each signature once. See the Signature Generation Guide.",
    "contact": {
      "email": "support@c2cplatform.com"
    }
  },
  "servers": [
    {
      "url": "https://ca-c2c-dev-api.calmsea-c64629ed.uaenorth.azurecontainerapps.io",
      "description": "Development / integration"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Orders"
    },
    {
      "name": "Account Balance"
    }
  ],
  "paths": {
    "/api/merchant/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "createOrder",
        "summary": "Create a deposit or withdrawal order",
        "description": "orderType=Deposit returns a hosted paymentPageUrl for the customer; orderType=Withdrawal requires customerAccountNumber. Signature enforcement: always on. A signed POST is accepted once (replays \u2192 401 SIGNATURE_REPLAYED).",
        "parameters": [
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              },
              "examples": {
                "deposit": {
                  "summary": "Deposit",
                  "value": {
                    "orderType": "Deposit",
                    "amount": 1500,
                    "currency": "PKR",
                    "walletType": "JazzCash",
                    "merchantOrderRef": "INV-10045",
                    "customerReference": "player_12345"
                  }
                },
                "withdrawal": {
                  "summary": "Withdrawal",
                  "value": {
                    "orderType": "Withdrawal",
                    "amount": 2000,
                    "currency": "PKR",
                    "walletType": "Easypaisa",
                    "merchantOrderRef": "PAYOUT-20017",
                    "customerReference": "player_12345",
                    "customerAccountNumber": "03001234567"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created, or the existing order for a repeated Idempotency-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CreateOrderResponse"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed ({error}) or request could not be bound, e.g. missing Idempotency-Key / unknown enum (application/problem+json).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "API key missing, invalid or revoked (empty body); or signature rejected (SignatureError body).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureError"
                }
              }
            }
          },
          "403": {
            "description": "Merchant account not active, or caller IP not whitelisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "IP not in whitelist."
                }
              }
            }
          },
          "413": {
            "description": "Request body larger than 64 KB (code PAYLOAD_TOO_LARGE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureError"
                }
              }
            }
          },
          "422": {
            "description": "Withdrawal not covered by the merchant balance (amount + fee + withdrawals in progress), wallet channel disabled, or no eligible member available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "No eligible member is currently available for this order."
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (100 requests/minute per API key). Empty body."
          }
        }
      }
    },
    "/api/merchant/orders/{id}/status": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "getOrderStatus",
        "summary": "Query order status",
        "description": "Returns the status of an order created with the calling API key.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "orderId returned at creation."
          },
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "responses": {
          "200": {
            "description": "Order status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/OrderStatusResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "API key missing, invalid or revoked (empty body); or signature rejected (SignatureError body).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureError"
                }
              }
            }
          },
          "404": {
            "description": "No order with this id for this API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Order not found."
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (100 requests/minute per API key). Empty body."
          }
        }
      }
    },
    "/api/merchant/orders/balance": {
      "get": {
        "tags": [
          "Account Balance"
        ],
        "operationId": "getBalance",
        "summary": "Query wallet balance",
        "parameters": [
          {
            "$ref": "#/components/parameters/Timestamp"
          },
          {
            "$ref": "#/components/parameters/Signature"
          }
        ],
        "responses": {
          "200": {
            "description": "Merchant wallet balance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BalanceResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "API key missing, invalid or revoked (empty body); or signature rejected (SignatureError body).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignatureError"
                }
              }
            }
          },
          "404": {
            "description": "API key not found or inactive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (100 requests/minute per API key). Empty body."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mk_live_<32 alphanumeric>",
        "description": "Merchant API key sent as Authorization: Bearer mk_live_..."
      }
    },
    "parameters": {
      "Timestamp": {
        "name": "X-C2C-Timestamp",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "example": "1760000000",
        "description": "Unix epoch seconds at signing time; must be within 300 seconds of server time."
      },
      "Signature": {
        "name": "X-C2C-Signature",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^sha256=[0-9a-f]{64}$"
        },
        "example": "sha256=c1c7c3f90a1b862cd8d9b8c173e59677d7acff2735a7bd9580ed69e18983558c",
        "description": "sha256= + lowercase hex HMAC-SHA256 of \"{timestamp}\\n{METHOD}\\n{path+query}\\n{hex sha256(raw body)}\" keyed with the API key's signing secret (sksec_...)."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "description": "Unique per order attempt and API key. A repeat returns the original order; request bodies are not compared."
      }
    },
    "schemas": {
      "OrderType": {
        "type": "string",
        "enum": [
          "Deposit",
          "Withdrawal"
        ]
      },
      "WalletType": {
        "type": "string",
        "enum": [
          "JazzCash",
          "Easypaisa",
          "TillID",
          "BankAccount"
        ]
      },
      "Currency": {
        "type": "string",
        "enum": [
          "PKR",
          "INR",
          "BDT"
        ],
        "default": "PKR"
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "Queued",
          "AwaitingCustomerPayment",
          "AwaitingMemberConfirmation",
          "AwaitingMemberPayout",
          "ManualReview",
          "Completed",
          "Rejected",
          "Expired",
          "CancelledTimeout",
          "Cancelled",
          "CancelledAuto",
          "Assigned",
          "Frozen",
          "Confirmed"
        ],
        "description": "Final success: Completed (legacy Confirmed). Final failure: Rejected, Expired, CancelledTimeout, Cancelled, CancelledAuto. Others are in progress."
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": [
          "orderType",
          "amount",
          "walletType"
        ],
        "properties": {
          "orderType": {
            "$ref": "#/components/schemas/OrderType"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "example": 1500
          },
          "walletType": {
            "$ref": "#/components/schemas/WalletType"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "merchantOrderRef": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "customerReference": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "customerAccountNumber": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50,
            "description": "Required when orderType is Withdrawal; ignored for deposits."
          },
          "callbackUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "maxLength": 500,
            "description": "Absolute http(s) URL for this order's webhooks; defaults to the Merchant Portal setting."
          },
          "successUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "maxLength": 500,
            "description": "Absolute http(s) URL. The hosted payment page sends the customer here when the order completes, appending c2c_order_id, c2c_order_reference and c2c_status."
          },
          "failureUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "maxLength": 500,
            "description": "Absolute http(s) URL. The hosted payment page sends the customer here when the order is rejected, expires or is cancelled (same parameters appended)."
          },
          "metadata": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "txnRefDigitsRequired": {
            "type": "integer",
            "minimum": 4,
            "maximum": 8,
            "default": 4
          },
          "maxRetryCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "default": 3,
            "description": "Withdrawals: reassignment attempts after the payout window passes."
          }
        }
      },
      "CreateOrderResponse": {
        "type": "object",
        "required": [
          "orderId",
          "paymentPageUrl",
          "status",
          "orderReference",
          "expiresAt"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentPageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Hosted payment page (deposits). Pre-signed; expires at expiresAt."
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "orderReference": {
            "type": "string",
            "example": "ORD-20261008120620-3f6b"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderStatusResponse": {
        "type": "object",
        "required": [
          "orderId",
          "orderReference",
          "status",
          "amount",
          "queuedAt"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderReference": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "amount": {
            "type": "number"
          },
          "queuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "BalanceResponse": {
        "type": "object",
        "required": [
          "availableBalance",
          "frozenBalance",
          "currency"
        ],
        "properties": {
          "availableBalance": {
            "type": "number"
          },
          "frozenBalance": {
            "type": "number"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "SignatureError": {
        "type": "object",
        "required": [
          "success",
          "error",
          "code",
          "traceId"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "SIGNATURE_REQUIRED",
              "SIGNATURE_MALFORMED",
              "SIGNATURE_EXPIRED",
              "SIGNATURE_INVALID",
              "SIGNATURE_REPLAYED",
              "PAYLOAD_TOO_LARGE"
            ]
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "traceId": {
            "type": "string"
          }
        }
      }
    }
  }
}
